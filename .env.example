# Copy to .env and fill in. .env is read from the repository root; real environment
# variables take precedence. Never commit .env.

# ---- LLM (any OpenAI-compatible Chat Completions endpoint) ----
OPENAI_API_KEY=sk-your-key-here
# Default is https://api.openai.com/v1. Examples:
#   DeepSeek:  https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1
# Model names are set per role in configs/openkage_default.yml (train.model).

# ---- Embeddings (optional) ----
# Without EMBEDDING_API_KEY the vector channel is off and retrieval uses graph
# structure only. The default EMBEDDING_DIM is 896 (the paper's setting); the
# retrieval thresholds in the yml (rho, similarity gates) were calibrated for it.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=896
# Texts per request; some providers cap it.
# EMBEDDING_BATCH=10
# Example public service: DashScope
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   text-embedding-v4 supports only fixed sizes (64/128/256/512/768/1024/1536/2048);
#   it has no 896, so set EMBEDDING_DIM=1024 for that provider.
# Instruction prefix for the query side of asymmetric models (not applied to documents):
# EMBEDDING_QUERY_PREFIX=

# ---- Paths (optional) ----
# OPENKAGE_RESULTS_DIR=/path/to/results
